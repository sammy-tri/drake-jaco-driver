module(name = "drake_jaco_driver")

bazel_dep(name = "gflags", version = "2.2.2")
bazel_dep(name = "lcm", version = "1.5.2")
bazel_dep(name = "rules_cc", version = "0.2.10")
bazel_dep(name = "rules_java", version = "8.16.1")
bazel_dep(name = "rules_python", version = "1.6.3")
bazel_dep(name = "rules_shell", version = "0.6.1")

extensions = use_extension("//:extensions.bzl", "extensions")
use_repo(extensions, "jaco_sdk")

DRAKE_VERSION = "1.46.0"

bazel_dep(name = "drake")
archive_override(
    module_name = "drake",
    canonical_id = DRAKE_VERSION,
    sha256 = "9f65f24256785baf0bfdb06abb5fccf236d20d7c9344c21ec1aaf9d308fcb33c",
    strip_prefix = "drake-{}".format(DRAKE_VERSION),
    url = "https://github.com/RobotLocomotion/drake/releases/download/v{}/drake-{}-src.tar.gz".format(
        DRAKE_VERSION,
        DRAKE_VERSION,
    ),
)


